# ================================================================
# Zinbconnect — exemple de configuration
# Copiez ce fichier en `.env` et remplissez vos valeurs.
# JAMAIS de vrais secrets dans git : `.env` est ignoré par .gitignore.
# ================================================================

# --- Environnement ---
# "local" (développement) ou "production"
APP_ENV=local
# URL publique du portail, utilisée pour le Cashless héberge etc. (optionnel)
APP_URL=http://127.0.0.1:8090

# Autorité d'accès réseau : le hotspot MikroTik débloque Internet.
# Ne pas faire valider un ticket par le PHP seul : il ne peut pas autoriser
# une adresse MAC/IP dans le routeur sans un connecteur réseau dédié.
PORTAL_AUTHORITY=routeros

# --- Base de données ---
# "sqlite" (recommandé : un seul fichier, sauvegarde par copie, aucun service)
# "mysql" (hébergeur mutualisé classique)
DB_DRIVER=sqlite

# --- Si DB_DRIVER=mysql ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zinbconnect
DB_USER=zinbuser
# Mot de passe de la base de données
DB_PASS=

# --- Si DB_DRIVER=sqlite ---
# Chemin du fichier de base, relatif au dossier du projet.
# Le dossier doit être accessible en écriture par PHP (et jamais servi par le web).
DB_PATH=data/zinbconnect.sqlite

# --- Clé de chiffrement des codes de tickets (OBLIGATOIRE pour réimprimer) ---
# Les codes sont stockés hachés (recherche) ET chiffrés avec cette clé (réimpression).
# Sans elle, les lots déjà générés ne peuvent plus être réimprimés.
# Générer une clé (64 caractères hexadécimaux) :
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Gardez-la secrète et sauvegardez-la séparément de la base.
APP_KEY=

# --- Compte administrateur initial (créé par install/init_db.php) ---
# Identifiant de connexion admin (téléphone +243… ou email)
ADMIN_IDENTIFIER=
# Mot de passe initial — sera haché (Argon2id) : le mot de passe n'apparaît jamais en clair dans la base.
# Choisissez-le FORT (12+ caractères, lettres + chiffres + symboles).
ADMIN_PASSWORD=
